# Camada de DEV por cima do .env (NODE_ENV=development — o default quando a
# variável não está setada). Postgres do loop de dev: instância própria,
# porta separada da stack de prova (D-02) para as duas poderem ficar de pé
# ao mesmo tempo sem colidir.
POSTGRES_PORT=5433
DATABASE_URL=postgres://<usuario>:<senha>@localhost:5433/orcamento

# Credencial de FIXTURE, não segredo — e por isso ela tem default em arquivo
# rastreado: no `docker-compose.yml` (que a injeta no seed) e no
# `scripts/crawl-gate.mjs` (que roda no host e faz o login). Preencha aqui só
# para SOBRESCREVER. Vazio não quebra mais nada: quem precisa provar o crawler
# sem área logada usa CRAWL_SEM_LOGIN=1, que declara a cobertura parcial.
PREATOR_TEST_USER=
PREATOR_TEST_PASS=

SESSAO_SEGREDO=
