# Camada de DEV por cima do .env (NODE_ENV=development — o default quando a
# variável não está setada). Postgres do loop de dev: instância própria,
# porta separada da stack de prova (D-02) para as duas poderem ficar de pé
# ao mesmo tempo sem colidir.
POSTGRES_PORT=5433
DATABASE_URL=postgres://<usuario>:<senha>@localhost:5433/orcamento

# Sem default no código (D-07): semear.ts e o gate de navegação exigem.
PREATOR_TEST_USER=
PREATOR_TEST_PASS=

SESSAO_SEGREDO=
