root = true

# ═══════════════════════════════════════════════════════════════════════════
#  UNIVERSAL
# ═══════════════════════════════════════════════════════════════════════════
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{js,jsx,mjs,cjs,ts,tsx,vue,css,scss,json,yml,yaml}]
indent_size = 2
