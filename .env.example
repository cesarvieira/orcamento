# =============================================================================
# .env.example — os NOMES das variáveis, nenhum valor real.
#
# Versionado de propósito. `.env` e `.env.*` são ignorados pelo Git.
# Credencial nunca entra aqui nem no preator-perfil.sh — ver D-07.
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO
# -----------------------------------------------------------------------------
# Usado pela API, pelo drizzle-kit e pelo seed.
DATABASE_URL=postgres://<usuario>:<senha>@localhost:5432/orcamento

# Banco usado APENAS pela suíte de testes de integração. É recriado a cada
# execução — nunca aponte para o banco de desenvolvimento.
DATABASE_URL_TESTE=postgres://<usuario>:<senha>@localhost:5432/orcamento_teste

# Credenciais do Postgres do compose (os dois composes leem daqui).
# Os composes trazem um default de desenvolvimento; em qualquer ambiente que
# não seja a sua máquina, preencha.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=orcamento
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# API  (porta 3000 — o Socket.IO vive na MESMA porta, path /realtime · D-04)
# -----------------------------------------------------------------------------
API_PORT=3000
NODE_ENV=development

# Segredo que assina o cookie de sessão. Gere um valor longo e aleatório.
# NUNCA commite o valor real.
SESSAO_SEGREDO=

# Vida da sessão, em horas.
SESSAO_TTL_HORAS=720

# Origem do front autorizada a mandar cookie (CORS + credenciais).
ORIGEM_WEB=http://localhost:3001

# -----------------------------------------------------------------------------
# WEB  (porta 3001 — Nuxt SSR · sessão em cookie httpOnly · D-01)
# -----------------------------------------------------------------------------
FRONT_PORT=3001

# Como o BROWSER alcança a API (vira URL pública no HTML servido).
API_BASE_PUBLICA=http://localhost:3000

# Como o SERVIDOR Nuxt alcança a API durante o SSR. Em compose é o nome do
# serviço; fora do compose é o mesmo valor de API_BASE_PUBLICA.
API_BASE_INTERNA=http://localhost:3000

# -----------------------------------------------------------------------------
# EMAIL  —  o adaptador é do código, o fornecedor é do ambiente (D-07)
# -----------------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_FROM=
MAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Parâmetro, não regra: muda por ambiente sem tocar na especificação.
CONVITE_TTL_HORAS=72

# -----------------------------------------------------------------------------
# SEED
# -----------------------------------------------------------------------------
# `true` faz o serviço `migrate` do compose semear depois de migrar.
# É o que o gate de deploy-fresh espera (banco limpo → migrate → seed).
# Em deploy real, deixe `false`.
SEMEAR=true

# -----------------------------------------------------------------------------
# GATE DE NAVEGAÇÃO  —  lido do AMBIENTE pelo crawler
# -----------------------------------------------------------------------------
# Neste produto TUDO é área logada: sem estas duas, o crawler cobre a tela de
# login e nada mais, e diz isso no veredito em vez de fingir que cobriu.
#
# São as credenciais da família de teste que `scripts/seed.ts` cria — e o seed
# EXIGE as duas: não há default no código. O valor de desenvolvimento vive num
# lugar só, no `docker-compose.yml` (serviço `migrate`). Fora da sua máquina,
# preencha aqui e não versione o `.env`.
PREATOR_TEST_USER=
PREATOR_TEST_PASS=

# Base que o crawler abre. Derivada de FRONT_PORT quando ausente.
FRONT_BASE=http://localhost:3001
