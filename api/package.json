{
  "name": "@orcamento/api",
  "private": true,
  "version": "0.0.0",
  "description": "API REST + tempo real do Orçamento Familiar",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "migracao:gerar": "drizzle-kit generate",
    "migrar": "tsx src/db/migrar.ts",
    "semear": "tsx ../scripts/seed.ts",
    "openapi:emitir": "tsx src/openapi/emitir.ts",
    "sentry:teste": "tsx src/scripts/sentry-teste.ts",
    "teste": "vitest run --reporter=default --reporter=json --outputFile.json=./relatorio-testes.json"
  },
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.0.1",
    "google-auth-library": "^11.0.2",
    "nodemailer": "^9.1.0",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.0",
    "socket.io-client": "^4.8.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
