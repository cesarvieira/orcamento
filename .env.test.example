# Camada de TEST por cima do .env (NODE_ENV=test — o Vitest define sozinho).
# Mesma instância do .env.development, banco separado (orcamento_teste): a
# suíte derruba o schema a cada execução, e apagar o de dev vira tela vazia.
DATABASE_URL_TESTE=postgres://<usuario>:<senha>@localhost:5433/orcamento_teste
