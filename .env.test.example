# Camada de TEST por cima do .env (NODE_ENV=test — o Vitest define sozinho).
# Mesma instância do .env.development, banco separado (orcamento_teste): a
# suíte derruba o schema a cada execução, e apagar o de dev vira tela vazia.
#
# ⚠️ Este arquivo é OPCIONAL. `api/testes/preparar-banco.ts` já tem o default
# de fixture — o mesmo Postgres que `pnpm run dev:banco` sobe pelos defaults
# do `docker-compose.dev.yml`. Preencha aqui só para apontar OUTRO banco.
# O motivo do default: `.env*` é gitignored e não viaja no `git worktree add`,
# então exigir este arquivo tornava a suíte impossível de rodar num worktree
# recém-aberto — e provar comportamento não pode depender de segredo.
DATABASE_URL_TESTE=postgres://<usuario>:<senha>@localhost:5433/orcamento_teste
