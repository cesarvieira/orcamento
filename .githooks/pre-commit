#!/usr/bin/env bash
# Bloco 1 instalado por preator/adocao/instalar.sh — bloqueia commit com segredo
# vazado. Não editar esse bloco por reflexo: um rerun do instalador o
# REESCREVE (ele não conhece o bloco 2 abaixo). Se isso acontecer, reaplique o
# bloco 2 a partir de `git log -p -- .githooks/pre-commit`.
set -uo pipefail
RAIZ="$(git rev-parse --show-toplevel)"
FAB="$RAIZ/preator"
[ -f "$FAB/esteira/raiz.sh" ] || exit 0
# shellcheck disable=SC1091
. "$FAB/esteira/raiz.sh" || exit 0
vazou=0
for f in $(git diff --cached --name-only --diff-filter=ACM | grep -vE '\.(png|jpg|jpeg|gif|pdf|xlsx|zip|ico|woff2?)$'); do
  [ -f "$f" ] || continue
  "$PY" "$FAB/esteira/ferramentas/seguranca/scan_segredos.py" "$f" >/dev/null 2>&1 || {
    echo "  ⛔ segredo em $f"; vazou=1; }
done
[ "$vazou" = 1 ] && { echo "[fábrica] BLOQUEADO: segredo detectado."; exit 1; }

# ─── Bloco 2 — do projeto (não é da fábrica) ────────────────────────────────
# Lint + format nos arquivos staged, via lint-staged. Só roda se pnpm e o
# node_modules existirem — clone fresco sem `pnpm install` ainda não trava.
if [ -f "$RAIZ/package.json" ] && [ -d "$RAIZ/node_modules" ] && command -v pnpm >/dev/null 2>&1; then
  ( cd "$RAIZ" && pnpm exec lint-staged ) || exit 1
fi

exit 0
